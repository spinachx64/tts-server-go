[Unit]
Description=Go Microsoft text-to-speech API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tts
Group=tts
WorkingDirectory=/opt/tts-server-go/current
EnvironmentFile=/opt/project-config/tts-server-go/service.env
ExecStart=/opt/tts-server-go/current/tts-server-go -port ${TTS_PORT} -token=${TTS_TOKEN} -token-db=${TTS_TOKEN_DB}
Environment=TZ=Asia/Shanghai
Environment=TTS_LOG_DIR=/opt/tts-server-go/logs
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Token management APIs require write access to the database directory.
ReadWritePaths=/opt/tts-server-go/data /opt/tts-server-go/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
